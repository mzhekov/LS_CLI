# Copy this file to .env and fill in the values.
#   cp .env.example .env
# .env is gitignored — never commit it.

# ── Required ────────────────────────────────────────────────────────────────

# Your Anthropic API key (get it at https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret between n8n and the API.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# n8n sends this in the X-API-Key header.
# Leave empty to disable auth (dev only — never in production).
LEADSAUCE_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────

# For docker-compose option B — the name of your existing n8n Docker network.
# Find it with: docker network ls
# N8N_NETWORK=n8n_default
